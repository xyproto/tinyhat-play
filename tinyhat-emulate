#!/bin/sh
notice() {
	if command -v tinyhat-notice >/dev/null 2>&1; then
		tinyhat-notice "$1" 6
	elif command -v notify-send >/dev/null 2>&1; then
		notify-send "tinyhat-emulate" "$1"
	else
		echo "$1" >&2
	fi
}
choose() {
	if [ "${XDG_CURRENT_DESKTOP-}" = dwl ] && command -v fuzzel >/dev/null 2>&1; then
		fuzzel --dmenu --prompt "$1 ❯ "
	else
		tinyhat-play --choose "$1"
	fi
}
platform=${1-}
emu=
core=
pattern=
case $platform in
nes) core=nestopia name="NES" pattern='\.(nes|fds|unf|unif)$' ;;
snes) emu=zsnes name="Super Nintendo" pattern='\.(sfc|smc|fig|swc)$' ;;
genesis) core=blastem name="Genesis" pattern='\.(md|gen|smd|bin)$' ;;
sms) core=blastem name="Master System" pattern='\.(sms|gg)$' ;;
gba) emu=mgba name="Game Boy Advance" pattern='\.(gba|gb|gbc)$' ;;
c64) name="C64" pattern='\.(d64|d71|d81|g64|prg|t64|tap|crt|p00)$' ;;
*)
	echo "usage: tinyhat-emulate nes|snes|genesis|sms|gba|c64 [game]" >&2
	exit 1
	;;
esac
dir=$HOME/ROMs/$platform
mkdir -p "$dir"
game=${2-}
if [ -z "$game" ]; then
	if [ "$platform" = genesis ] && command -v tinyhat-pick >/dev/null 2>&1; then
		game=$(tinyhat-pick "$name game" "$dir") || exit 0
		[ -n "$game" ] || exit 0
	else
		list=$(find "$dir" /media /run/media -maxdepth 4 -type f 2>/dev/null | grep -i -E "$pattern" | sort)
		if [ "$platform" = c64 ]; then
			game=$(printf 'Start BASIC\n%s' "$list" | choose "$name") || exit 0
			[ "$game" = "Start BASIC" ] && game=
		elif [ -z "$list" ] && [ "$platform" = snes ]; then
			exec zsnes
		elif [ -z "$list" ]; then
			notice "Put $name games in ~/ROMs/$platform or on a USB stick"
			exit 0
		else
			game=$(printf '%s\n' "$list" | choose "$name game") || exit 0
			[ -n "$game" ] || exit 0
		fi
	fi
fi
export SDL_RENDER_DRIVER=${TINYHAT_SDL_RENDER:-opengles2,opengl,software}
if [ -n "$emu" ]; then
	exec "$emu" "$game"
fi
if [ -z "$core" ]; then
	emu=x64sc
	case $game in
	*.prg | *.PRG)
		case $(od -An -tx1 -N2 "$game" | tr -d ' \n') in
		011c) emu=x128 ;;
		0110 | 0112 | 0104) emu=xvic ;;
		esac
		;;
	esac
	[ -n "$game" ] && exec "$emu" -autostart "$game"
	exec x64sc
fi
for libdir in /usr/lib/libretro /usr/lib64/libretro /usr/local/lib/libretro; do
	if [ -f "$libdir/${core}_libretro.so" ]; then
		exec tinyhat-retro "$libdir/${core}_libretro.so" "$game"
	fi
done
notice "The $core libretro core is not installed (look for libretro-$core)"
exit 1
